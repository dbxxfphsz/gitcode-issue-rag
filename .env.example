# ============ GitCode 配置 ============
# GitCode API Token（评论功能需要，只读扫描可不配）
GITCODE_TOKEN=
# 仓库地址
GITCODE_REPO=Ascend/msinsight
GITCODE_BASE_URL=https://gitcode.com

# ============ LLM / Embedding 配置 ============
OPENAI_API_KEY=sk-your-api-key
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ============ 知识库配置 ============
# 知识库存储目录
KB_DIR=./issue-knowledge-base
# FAQ 输出目录
FAQ_DIR=./docs/faq

# ============ 相似性扫描配置 ============
# 相似度阈值（0-1）
SIMILARITY_THRESHOLD=0.75
# 返回相似 Issue 数量
SCAN_TOP_K=5
# 默认模式: report（仅报告）/ comment（报告并评论）
SCAN_MODE=report
# 是否检索已关闭 Issue
INCLUDE_CLOSED=true
# 是否包含评论内容
INCLUDE_COMMENTS=true
# 忽略的标签（逗号分隔，含这些标签的 Issue 不参与扫描）
IGNORE_LABELS=

# ============ 模板清洗配置（LLM 语义判定）============
# 是否启用录入/扫描前的模板噪声清洗（剔除客套话/提交须知/安全提醒，保留结构标题与用户内容）
CLEAN_TEMPLATE=true
# 频率预筛阈值：一行出现在 >= 该数量 Issue 中才送 LLM 判定（只针对重复噪声，独特内容不调 LLM）
TEMPLATE_MIN_SUPPORT=3
# 规范化后最小行长度：短于此的行不判定、直接保留（避免"无""1."等浪费调用）
TEMPLATE_MIN_LINE_LEN=4
# 每次 LLM 调用判定的行数（分批送审）
TEMPLATE_LLM_BATCH=40

# ============ 爬取配置 ============
CRAWL_PAGE_SIZE=30
CRAWL_DELAY=1.0
