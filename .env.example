# ============ LLM / Embedding 配置 ============
# OpenAI API（也可用兼容接口如 DeepSeek、智谱等）
OPENAI_API_KEY=sk-your-api-key
OPENAI_API_BASE=https://api.openai.com/v1
# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small
# LLM 模型（用于生成答案摘要，可选）
LLM_MODEL=gpt-4o-mini

# ============ GitCode 爬虫配置 ============
GITCODE_REPO=Ascend/msinsight
GITCODE_BASE_URL=https://gitcode.com
# 每页爬取数量
CRAWL_PAGE_SIZE=20
# 请求间隔（秒），避免被封
CRAWL_DELAY=1.0

# ============ 向量库配置 ============
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=gitcode_issues

# ============ 查重配置 ============
# 相似度阈值（0-1），高于此值判定为重复
DEDUP_SIMILARITY_THRESHOLD=0.85
# 检索返回条数
DEDUP_TOP_K=3

# ============ 知识库整合配置 ============
# 整合时相似度阈值（高于此值的条目才合并）
CONSOLIDATION_SIMILARITY_THRESHOLD=0.90

# ============ 定时任务 ============
# 每日爬取时间（24小时制 HH:MM）
CRON_HOUR=02
CRON_MINUTE=00

# ============ 服务配置 ============
HOST=0.0.0.0
PORT=8000
